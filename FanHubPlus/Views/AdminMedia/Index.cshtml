@model PagedList<MediaItem>

@{
    ViewData["Title"] = "Manage Media";
    Layout = "_AdminLayout";
    var q = Context.Request.Query["q"].ToString();
    var mediaType = Context.Request.Query["mediaType"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
    var stats = ViewBag.RatingStats as Dictionary<int, (double Average, int Count)> ?? new Dictionary<int, (double Average, int Count)>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Multimedia Management</h2>
        <div>
            <a asp-action="Ratings" class="btn btn-secondary me-2">All Ratings</a>
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Media</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-3">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search title" aria-label="Search media" />
        </div>
        <div class="col-md-2">
            <select name="categoryId" class="form-select" aria-label="Filter by category" asp-items="ViewBag.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="mediaType" class="form-select" aria-label="Filter by media type">
                <option value="">All types</option>
                @foreach (var t in AdminOptions.MediaTypes)
                {
                    <option value="@t" selected="@(mediaType == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="tagId" class="form-select" aria-label="Filter by tag" asp-items="ViewBag.Tags">
                <option value="">All tags</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sort" class="form-select" aria-label="Sort order">
                <option value="" selected="@(sort == "")">Newest first</option>
                <option value="oldest" selected="@(sort == "oldest")">Oldest first</option>
                <option value="title" selected="@(sort == "title")">Title A-Z</option>
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Go</button>
        </div>
        <div class="col-12">
            <a asp-action="Index" class="btn btn-link btn-sm px-0">Reset filters</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Rating</th>
                    <th>Uploaded</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td><span class="badge bg-secondary">@item.MediaType</span></td>
                        <td>@(item.Category?.Name ?? "-")</td>
                        <td>
                            @foreach (var mt in item.MediaTags)
                            {
                                <span class="badge bg-info text-dark me-1">@mt.Tag?.Name</span>
                            }
                        </td>
                        <td>
                            @if (stats.TryGetValue(item.MediaId, out var s))
                            {
                                <span>@s.Average.ToString("0.0") / 5 <small class="text-muted">(@s.Count)</small></span>
                            }
                            else
                            {
                                <span class="text-muted">No ratings</span>
                            }
                        </td>
                        <td>@item.UploadedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.MediaId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.MediaId" class="btn btn-sm btn-info text-white">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.MediaId" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No media matches these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
