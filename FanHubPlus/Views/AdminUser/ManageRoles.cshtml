@model List<FanHubPlus.Controllers.UserRoleViewModel>

@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Manage Roles for: <span class="text-primary">@ViewBag.UserName</span></h2>
    <hr />
    <form asp-action="ManageRoles" method="post">
        <input type="hidden" name="userId" value="@ViewBag.UserId" />
        
        <div class="card col-md-6 mb-3">
            <div class="card-body">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="form-check m-2">
                        <input type="hidden" asp-for="@Model[i].RoleId" />
                        <input type="hidden" asp-for="@Model[i].RoleName" />
                        <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                        <label class="form-check-label" asp-for="@Model[i].IsSelected">
                            <strong>@Model[i].RoleName</strong>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="form-group">
            <input type="submit" value="Update Roles" class="btn btn-success" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>