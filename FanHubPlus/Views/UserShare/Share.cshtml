@{
    ViewData["Title"] = "Share | FanHub+";
    var title = ViewBag.Title as string ?? "Check this out on FanHub+";
    var url = ViewBag.Url as string ?? "/";
    var fullUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{url}";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<main class="explore-page py-4">
    <div class="container-fluid site-container">
        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb fanhub-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Share</li>
            </ol>
        </nav>

        <div class="row justify-content-center my-4">
            <div class="col-lg-7 col-md-9">
                <div class="cyber-nebula-card p-4 p-md-5 rounded-4 reveal text-center shadow-lg">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <div class="p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(168, 85, 247, 0.2); color: #FF4D8D;">
                            <i class="bi bi-share-fill fs-2"></i>
                        </div>
                        <h1 class="h2 fw-extrabold text-white mb-2" style="font-family: 'Manrope', sans-serif;">Share Content</h1>
                        <p class="lead text-primary fw-semibold mb-0">"@title"</p>
                        <small class="text-muted d-block mt-1 text-truncate" style="max-width: 90%; margin: 0 auto;">@fullUrl</small>
                    </div>

                    <div class="d-flex flex-column flex-sm-row flex-wrap justify-content-center gap-3 mb-4">
                        <a class="cyber-meta-btn px-4 py-3 justify-content-center share-link" data-platform="Facebook"
                           href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(fullUrl)"
                           target="_blank" rel="noopener">
                            <i class="bi bi-facebook text-primary me-2 fs-5"></i> Facebook
                        </a>

                        <a class="cyber-meta-btn px-4 py-3 justify-content-center share-link" data-platform="Twitter"
                           href="https://twitter.com/intent/tweet?text=@Uri.EscapeDataString(title)&url=@Uri.EscapeDataString(fullUrl)"
                           target="_blank" rel="noopener">
                            <i class="bi bi-twitter-x text-info me-2 fs-5"></i> X / Twitter
                        </a>

                        <a class="cyber-meta-btn px-4 py-3 justify-content-center share-link" data-platform="WhatsApp"
                           href="https://wa.me/?text=@Uri.EscapeDataString(title + " " + fullUrl)"
                           target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp text-success me-2 fs-5"></i> WhatsApp
                        </a>

                        <button type="button" class="cyber-read-btn px-4 py-3 justify-content-center" id="copy-link-btn" data-url="@fullUrl">
                            <i class="bi bi-link-45deg me-2 fs-5"></i> Copy Link
                        </button>
                    </div>

                    <div id="copy-feedback" class="alert alert-success border-0 bg-success bg-opacity-20 text-success rounded-pill py-2 px-4 d-inline-block small" style="display:none !important;">
                        <i class="bi bi-check-circle-fill me-1"></i> Direct link copied to clipboard!
                    </div>

                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <a href="javascript:history.back()" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Back to previous page
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        const isAuthenticated = @isAuthenticated.ToString().ToLower();

        function logShare(platform, sharedUrl) {
            if (!isAuthenticated) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/share/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `platform=${encodeURIComponent(platform)}&sharedUrl=${encodeURIComponent(sharedUrl)}&__RequestVerificationToken=${encodeURIComponent(token)}`
            }).catch(() => { /* logging is best-effort, ignore failures */ });
        }

        document.querySelectorAll('.share-link').forEach(function (link) {
            link.addEventListener('click', function () {
                logShare(this.dataset.platform, this.href);
            });
        });

        document.getElementById('copy-link-btn').addEventListener('click', function () {
            const url = this.dataset.url;
            navigator.clipboard.writeText(url).then(function () {
                const feedback = document.getElementById('copy-feedback');
                feedback.style.setProperty('display', 'inline-block', 'important');
                setTimeout(function () { feedback.style.setProperty('display', 'none', 'important'); }, 2500);
                logShare('CopyLink', url);
            });
        });
    </script>
}