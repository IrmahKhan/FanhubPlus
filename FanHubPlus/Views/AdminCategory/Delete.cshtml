@model Category

@{
    ViewData["Title"] = "Delete Category";
    Layout = "_AdminLayout";
    var linkedItemCount = (Model.Contents?.Count ?? 0)
        + (Model.CharacterProfiles?.Count ?? 0)
        + (Model.MerchandiseItems?.Count ?? 0);
}

<div class="page-head">
    <div>
        <h1 class="page-head-title"><i class="fa-solid fa-trash text-danger"></i> Delete Category</h1>
        <p class="page-head-subtitle">This action cannot be undone.</p>
    </div>
</div>

<div class="content-card confirm-card">
    <div class="content-card-header">
        <strong>Confirm deletion</strong>
    </div>
    <div class="content-card-body">
        <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>

        @if (linkedItemCount > 0)
        {
            <div class="alert alert-warning mb-3">
                <i class="fa-solid fa-triangle-exclamation"></i>
                This category still has <strong>@linkedItemCount</strong> linked item(s)
                (@(Model.Contents?.Count ?? 0) content, @(Model.CharacterProfiles?.Count ?? 0) characters,
                @(Model.MerchandiseItems?.Count ?? 0) merchandise). Move or delete those first.
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        }
        else
        {
            <dl class="row mb-3">
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
            </dl>

            <form asp-action="Delete" method="post" class="form-actions">
                <input type="hidden" asp-for="CategoryId" />
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete Category</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
