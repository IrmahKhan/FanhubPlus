@model ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid px-4 py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card dash-card-panel shadow-lg border-0 rounded-4 p-4">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-20">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="profile-avatar" />
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-2 text-white"
                             style="width: 90px; height: 90px; background: linear-gradient(135deg, #ff2e93, #8b5cf6);">
                            @((Model.FullName ?? Model.UserName)?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                    }

                    <div>
                        <h1 class="fw-bold mb-1 fs-3">@(Model.FullName ?? Model.UserName)</h1>
                        <p class="text-muted mb-0"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
                    </div>
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="dash-card-item p-3 rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="text-muted small text-uppercase fw-bold tracking-wider">
                            <i class="bi bi-geo-alt me-1"></i> Address
                        </span>
                        <span class="fw-medium">@(Model.Address ?? "Not set")</span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-20">
                    <a asp-action="Edit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card dash-card-panel shadow-lg border-0 rounded-4 p-4">
                <h6 class="fw-bold mb-3 text-uppercase small tracking-wider text-muted">Account</h6>
                <div class="d-flex flex-column gap-2">
                    <a asp-action="Preferences" class="dash-card-item text-decoration-none p-3 rounded-3 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-sliders me-2 text-primary"></i>Preferences</span>
                        <i class="bi bi-chevron-right text-primary"></i>
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="dash-card-item text-decoration-none p-3 rounded-3 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-gear me-2 text-primary"></i>Account Settings</span>
                        <i class="bi bi-chevron-right text-primary"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
