@model IEnumerable<Quiz>

@{
    ViewData["Title"] = "Manage Quizzes";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Fan Quiz Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add New Quiz
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Questions</th>
                <th>Attempts</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var quiz in Model)
            {
                <tr>
                    <td><strong>@quiz.Title</strong></td>
                    <td>@quiz.Category.Name</td>
                    <td><span class="badge bg-secondary">@quiz.Questions.Count</span></td>
                    <td><span class="badge bg-info text-dark">@quiz.Attempts.Count</span></td>
                    <td class="text-end">
                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="Questions" asp-route-quizId="@quiz.QuizId" class="btn btn-sm btn-success">Questions</a>
                            <a asp-action="Edit" asp-route-id="@quiz.QuizId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@quiz.QuizId" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="text-muted">Abhi koi quiz nahi bana &mdash; upar se "Add New Quiz" karein.</p>
    }
</div>
