@model QuizQuestion

@{
    ViewData["Title"] = "Edit Question";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Edit Question - @ViewBag.QuizTitle</h2>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <form asp-action="EditQuestion" method="post">
                <input type="hidden" asp-for="QuestionId" />
                <input type="hidden" asp-for="QuizId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="QuestionText" class="form-label"></label>
                    <textarea asp-for="QuestionText" class="form-control" rows="2"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="OptionA" class="form-label">Option A</label>
                        <input asp-for="OptionA" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="OptionB" class="form-label">Option B</label>
                        <input asp-for="OptionB" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="OptionC" class="form-label">Option C</label>
                        <input asp-for="OptionC" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="OptionD" class="form-label">Option D</label>
                        <input asp-for="OptionD" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CorrectOption" class="form-label">Correct Option</label>
                    <select asp-for="CorrectOption" class="form-select">
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                    </select>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Questions" asp-route-quizId="@Model.QuizId" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
