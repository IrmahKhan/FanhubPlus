@model Quiz

@{
    ViewData["Title"] = "Manage Questions";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Questions - @Model.Title</h2>
        <a asp-action="CreateQuestion" asp-route-quizId="@Model.QuizId" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Question
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Question</th>
                <th>A</th>
                <th>B</th>
                <th>C</th>
                <th>D</th>
                <th>Correct</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var q in Model.Questions)
            {
                <tr>
                    <td>@i</td>
                    <td>@q.QuestionText</td>
                    <td>@q.OptionA</td>
                    <td>@q.OptionB</td>
                    <td>@q.OptionC</td>
                    <td>@q.OptionD</td>
                    <td><span class="badge bg-success">@q.CorrectOption</span></td>
                    <td class="text-end">
                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="EditQuestion" asp-route-id="@q.QuestionId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteQuestion" method="post" class="d-inline" onsubmit="return confirm('Delete this question?');">
                                <input type="hidden" name="id" value="@q.QuestionId" />
                                <input type="hidden" name="quizId" value="@Model.QuizId" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>

    @if (!Model.Questions.Any())
    {
        <p class="text-muted">Is quiz mein abhi koi question nahi hai &mdash; "Add Question" se add karein.</p>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Quizzes</a>
</div>
