@model Note
@{
    ViewData["Title"] = "Delete Note";
}

<section class="note-form-page">
    <h1>Delete Note</h1>
    <p>Are you sure you want to delete this note? This can't be undone.</p>

    <div class="card">
        <div class="card-body">
            <h3>@Model.Title</h3>
            <p class="text-muted">@Model.CreatedAt.ToString("dd MMM yyyy")</p>
            <p>@Model.Content</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.NoteId" method="post">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Details" asp-route-id="@Model.NoteId" class="btn btn-link">Cancel</a>
    </form>
</section>
