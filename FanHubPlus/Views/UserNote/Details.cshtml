@model Note
@{
    ViewData["Title"] = Model.Title;
}

<section class="note-details">
    <h1>@Model.Title</h1>
    <p class="text-muted">Created on @Model.CreatedAt.ToString("dd MMM yyyy")</p>

    <div class="note-content">
        <p>@Model.Content</p>
    </div>

    <div class="card-actions">
        <a asp-action="Edit" asp-route-id="@Model.NoteId" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.NoteId" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-link">Back to Notes</a>
    </div>
</section>
