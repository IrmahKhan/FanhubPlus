@using FanHubPlus.ViewModels
@model PagedList<ItemViewRow>

@{
    ViewData["Title"] = "Content Views & Popularity";
    Layout = "_AdminLayout";
    var q = Context.Request.Query["q"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Content Views &amp; Popularity</h2>
        <div class="d-flex gap-2">
            <form asp-action="RecalculatePopularity" method="post">
                <button type="submit" class="btn btn-success">Refresh popularity scores</button>
            </form>
            <a asp-action="ContentViewLog" class="btn btn-outline-secondary">View log</a>
            <a asp-action="Index" class="btn btn-secondary">Back to Analytics</a>
        </div>
    </div>
    <p class="text-muted">Popularity score = views + 2 &times; bookmarks. Use &ldquo;Refresh popularity scores&rdquo; to update the stored score.</p>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-4">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search by title" aria-label="Search content" />
        </div>
        <div class="col-md-3">
            <select name="sort" class="form-select" aria-label="Sort by">
                <option value="" selected="@(sort == "")">Most viewed</option>
                <option value="score" selected="@(sort == "score")">Popularity score</option>
                <option value="recent" selected="@(sort == "recent")">Recently viewed</option>
                <option value="title" selected="@(sort == "title")">Title (A-Z)</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-action="ContentViews" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Views</th>
                    <th>Unique viewers</th>
                    <th>Popularity score</th>
                    <th>Last viewed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.CategoryName</td>
                        <td><span class="badge bg-info text-dark">@item.Views</span></td>
                        <td>@item.UniqueViewers</td>
                        <td>@item.PopularityScore</td>
                        <td>@(item.LastViewed?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        <td><a asp-action="ContentViewLog" asp-route-contentId="@item.Id" class="btn btn-sm btn-outline-secondary">Log</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No content found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
