@model PagedList<UserActivity>

@{
    ViewData["Title"] = "User Activity Log";
    Layout = "_AdminLayout";
    var users = ViewBag.Users as Dictionary<string, string> ?? new Dictionary<string, string>();
    var q = Context.Request.Query["q"].ToString();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Activity Log</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Analytics</a>
    </div>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-5">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search action description" aria-label="Search activity" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="UserActivity" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var act in Model)
                {
                    <tr>
                        <td>@(users.TryGetValue(act.UserId, out var u) ? u : "Unknown User")</td>
                        <td><strong>@act.ActionDescription</strong></td>
                        <td>@act.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No activity found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
