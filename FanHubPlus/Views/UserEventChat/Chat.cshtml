@using Microsoft.AspNetCore.Identity
@using FanHubPlus.Data
@inject UserManager<ApplicationUser> UserManager
@model List<EventChatMessage>

@{
    var eventItem = (Event)ViewBag.Event;
    ViewData["Title"] = "Live Chat - " + eventItem.Title;
}

<div class="container py-4">
    <a asp-controller="UserEvent" asp-action="Details" asp-route-id="@eventItem.EventId" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> Back to Event
    </a>

    <h2><i class="bi bi-chat-dots me-2"></i>@eventItem.Title - Live Chat</h2>
    <p class="text-muted">Yahan fans is event ke bare mein real-time discuss kar sakte hain.</p>

    <partial name="_WatchPartyCountdown" model="eventItem" />

    <div class="card">
        <div id="chatBox" class="card-body" style="height: 400px; overflow-y: auto; background: #f8f9fa;">
            @foreach (var msg in Model)
            {
                <div class="mb-2">
                    <strong>@msg.UserName</strong>
                    <span class="text-muted small">@msg.SentAt.ToString("hh:mm tt")</span>
                    <div>@msg.Message</div>
                </div>
            }
        </div>
        <div class="card-footer">
            <form id="chatForm" class="d-flex gap-2" onsubmit="return false;">
                <input type="text" id="messageInput" class="form-control" placeholder="Apna message likhein..." maxlength="500" />
                <button type="submit" id="sendBtn" class="btn btn-primary">Send</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        const eventId = @eventItem.EventId;
        const chatBox = document.getElementById('chatBox');

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/eventchat")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (userName, message, time) {
            const div = document.createElement('div');
            div.className = 'mb-2';

            const nameEl = document.createElement('strong');
            nameEl.textContent = userName;

            const timeEl = document.createElement('span');
            timeEl.className = 'text-muted small';
            timeEl.textContent = ' ' + time;

            const textEl = document.createElement('div');
            textEl.textContent = message;

            div.appendChild(nameEl);
            div.appendChild(timeEl);
            div.appendChild(textEl);
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinEventGroup", eventId);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        document.getElementById('chatForm').addEventListener('submit', function () {
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            if (!message) return;

            connection.invoke("SendMessage", eventId, message);
            input.value = '';
        });
    </script>
}
