@model IEnumerable<NearbyEventViewModel>

@{
    ViewData["Title"] = "Nearby Events";
    var availableCities = ViewBag.AvailableCities as List<string> ?? new List<string>();
    var selectedCity = ViewBag.SelectedCity as string;
    bool usingGeolocation = ViewBag.UsingGeolocation ?? false;
    double radiusKm = ViewBag.RadiusKm ?? 100;
    double userLat = usingGeolocation ? (double)ViewBag.UserLat : 0d;
    double userLng = usingGeolocation ? (double)ViewBag.UserLng : 0d;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill me-2 text-danger"></i>Nearby Events</h2>
            <p class="text-muted mb-0">Find live events happening close to you, using your device's GPS or a city.</p>
        </div>
        <div class="btn-group" role="group">
            <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-grid-fill me-1"></i>All Events</a>
            <a asp-action="Upcoming" class="btn btn-outline-primary"><i class="bi bi-clock-history me-1"></i>Upcoming</a>
            <a asp-action="Nearby" class="btn btn-primary active"><i class="bi bi-geo-alt-fill me-1"></i>Nearby</a>
        </div>
    </div>

    <!-- GPS Location Card -->
    <div class="card border-0 shadow-sm p-3 mb-3 bg-light">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <button type="button" id="useMyLocationBtn" class="btn btn-danger">
                <i class="bi bi-crosshair me-1"></i> Use My Location (GPS)
            </button>

            <div class="d-flex align-items-center gap-2">
                <label for="radiusSelect" class="form-label mb-0 small fw-bold">Radius:</label>
                <select id="radiusSelect" class="form-select form-select-sm" style="width:auto">
                    <option value="10" selected="@(radiusKm == 10)">10 km</option>
                    <option value="25" selected="@(radiusKm == 25)">25 km</option>
                    <option value="50" selected="@(radiusKm == 50)">50 km</option>
                    <option value="100" selected="@(radiusKm == 100)">100 km</option>
                    <option value="500" selected="@(radiusKm == 500)">500 km</option>
                </select>
            </div>

            <span id="geoStatus" class="small text-muted"></span>

            @if (usingGeolocation)
            {
                <a asp-action="Nearby" class="btn btn-outline-secondary btn-sm ms-auto">
                    <i class="bi bi-x-circle me-1"></i> Clear GPS filter
                </a>
            }
        </div>
    </div>

    <!-- City Selector Pills (fallback when GPS isn't used/available) -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
        <label class="form-label fw-bold mb-2"><i class="bi bi-building me-1"></i>Or Select a City:</label>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Nearby" class="btn btn-sm @(string.IsNullOrEmpty(selectedCity) && !usingGeolocation ? "btn-dark" : "btn-outline-dark") rounded-pill">
                All Cities
            </a>
            @foreach (var city in availableCities)
            {
                <a asp-action="Nearby" asp-route-city="@city" class="btn btn-sm @(selectedCity == city && !usingGeolocation ? "btn-primary" : "btn-outline-primary") rounded-pill">
                    <i class="bi bi-geo-alt me-1"></i>@city
                </a>
            }
        </div>
    </div>

    <!-- Map showing the filtered events (and the visitor's location when GPS is used) -->
    <div id="nearbyMap" class="rounded-3 shadow-sm mb-4" style="height: 350px;"></div>

    <!-- Events List -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center p-5 rounded-3">
            <i class="bi bi-geo-fill display-4 d-block mb-3 text-muted"></i>
            <h4>
                No Events @(usingGeolocation ? $"within {radiusKm:0} km of your location" : $"in {(string.IsNullOrEmpty(selectedCity) ? "your selected area" : selectedCity)}")
            </h4>
            <p class="mb-0">Try a larger radius, a different city, or check back later.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                var evt = item.Event;
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-top border-3 border-danger event-map-card"
                         data-coords="@evt.LocationCoordinates" data-title="@evt.Title">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-danger">
                                    <i class="bi bi-geo-alt-fill me-1"></i>@(string.IsNullOrEmpty(evt.City) ? "Nearby" : evt.City)
                                </span>
                                @if (item.DistanceKm.HasValue)
                                {
                                    <span class="badge bg-dark"><i class="bi bi-signpost-split me-1"></i>@item.DistanceKm.Value.ToString("0.#") km away</span>
                                }
                            </div>
                            <h5 class="fw-bold text-dark">@evt.Title</h5>
                            <p class="text-muted small mb-3">@evt.EventDate.ToString("MMMM dd, yyyy - hh:mm tt")</p>
                            <p class="card-text text-secondary line-clamp-2 small">@evt.Description</p>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 pb-3">
                            <a asp-action="Details" asp-route-id="@evt.EventId" class="btn btn-outline-danger btn-sm w-100">
                                View Venue & Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            var geoStatus = document.getElementById('geoStatus');
            var btn = document.getElementById('useMyLocationBtn');
            var radiusSelect = document.getElementById('radiusSelect');

            // "Use My Location" -> real browser GPS via navigator.geolocation,
            // then reload this page with lat/lng/radius query params.
            btn.addEventListener('click', function () {
                if (!navigator.geolocation) {
                    geoStatus.textContent = 'Geolocation is not supported by this browser.';
                    return;
                }

                geoStatus.textContent = 'Detecting your location...';
                btn.disabled = true;

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        var lat = position.coords.latitude;
                        var lng = position.coords.longitude;
                        var radius = radiusSelect.value;
                        var url = new URL(window.location.href);
                        url.searchParams.set('lat', lat);
                        url.searchParams.set('lng', lng);
                        url.searchParams.set('radiusKm', radius);
                        url.searchParams.delete('city');
                        window.location.href = url.toString();
                    },
                    function (error) {
                        btn.disabled = false;
                        geoStatus.textContent = 'Could not get your location: ' + error.message;
                    },
                    { enableHighAccuracy: true, timeout: 10000 }
                );
            });

            // Build the map from data- attributes on each event card, so no extra
            // controller round-trip is needed just to draw markers.
            var map = L.map('nearbyMap');
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 18
            }).addTo(map);

            var bounds = [];

            @if (usingGeolocation)
            {
                <text>
                var userLat = @Html.Raw(Json.Serialize(userLat));
                var userLng = @Html.Raw(Json.Serialize(userLng));
                var userMarker = L.marker([userLat, userLng], {
                    icon: L.divIcon({ className: 'user-location-dot', html: '<i class="bi bi-person-fill-up" style="color:#0d6efd;font-size:1.5rem;"></i>' })
                }).addTo(map).bindPopup('Your location');
                bounds.push([userLat, userLng]);
                </text>
            }

            document.querySelectorAll('.event-map-card').forEach(function (card) {
                var coords = card.getAttribute('data-coords');
                if (!coords) return;
                var parts = coords.split(',').map(function (p) { return parseFloat(p.trim()); });
                if (parts.length !== 2 || isNaN(parts[0]) || isNaN(parts[1])) return;

                var marker = L.marker([parts[0], parts[1]]).addTo(map).bindPopup(card.getAttribute('data-title'));
                bounds.push([parts[0], parts[1]]);
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [30, 30] });
            } else {
                map.setView([20, 0], 2); // no coordinates available yet — show a world view
            }
        })();
    </script>
}
