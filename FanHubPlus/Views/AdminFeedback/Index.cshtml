@model PagedList<Feedback>

@{
    ViewData["Title"] = "User Feedbacks";
    Layout = "_AdminLayout";
    var users = ViewBag.Users as Dictionary<string, string> ?? new Dictionary<string, string>();
    var type = Context.Request.Query["type"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var q = Context.Request.Query["q"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Feedback & Support Management</h2>
    </div>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-3">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search message" aria-label="Search feedback" />
        </div>
        <div class="col-md-2">
            <select name="type" class="form-select" aria-label="Filter by type">
                <option value="">All types</option>
                @foreach (var t in AdminOptions.FeedbackTypes)
                {
                    <option value="@t" selected="@string.Equals(type, t, StringComparison.OrdinalIgnoreCase)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select" aria-label="Filter by status">
                <option value="">All statuses</option>
                @foreach (var s in AdminOptions.FeedbackStatuses)
                {
                    <option value="@s" selected="@(status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="sort" class="form-select" aria-label="Sort order">
                <option value="" selected="@(sort == "")">Newest first</option>
                <option value="oldest" selected="@(sort == "oldest")">Oldest first</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Type</th>
                    <th>Message</th>
                    <th>User</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var userName = users.TryGetValue(item.UserId, out var u) ? u : "Unknown";
                    <tr>
                        <td><strong>@item.Type</strong></td>
                        <td class="text-muted">@(item.Message.Length > 60 ? item.Message.Substring(0, 57) + "..." : item.Message)</td>
                        <td>@userName</td>
                        <td>
                            @if (item.Status == "Resolved" || item.Status == "Closed")
                            {
                                <span class="badge bg-success">@item.Status</span>
                            }
                            else if (item.Status == "In Progress")
                            {
                                <span class="badge bg-primary">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="Details" asp-route-id="@item.FeedbackId" class="btn btn-sm btn-info text-white">Details</a>
                            <a asp-action="UpdateStatus" asp-route-id="@item.FeedbackId" class="btn btn-sm btn-warning">Status</a>
                            <a asp-action="Delete" asp-route-id="@item.FeedbackId" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No feedback matches these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
