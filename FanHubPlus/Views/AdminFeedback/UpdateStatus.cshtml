@model Feedback

@{
    ViewData["Title"] = "Update Status";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Update Feedback Status</h2>
    <hr />
    <div class="card shadow-sm col-md-6">
        <div class="card-body">
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" asp-for="FeedbackId" />

                <div class="mb-3">
                    <label class="form-label"><strong>Type:</strong> @Model.Type</label>
                </div>
                <div class="mb-3">
                    <label class="form-label"><strong>Message:</strong></label>
                    <p class="p-2 bg-light border rounded">@Model.Message</p>
                </div>

                <div class="mb-3">
                    <label for="status" class="form-label">Select New Status</label>
                    <select name="status" class="form-select">
                        <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                        <option value="In Progress" selected="@(Model.Status == "In Progress")">In Progress</option>
                        <option value="Resolved" selected="@(Model.Status == "Resolved")">Resolved</option>
                        <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>