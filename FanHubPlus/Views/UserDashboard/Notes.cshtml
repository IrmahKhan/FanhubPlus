@model List<Note>
@{
    ViewData["Title"] = "My Notes";
}

<section class="dashboard-page">
    <div class="page-header">
        <h1>My Notes</h1>
        <a asp-controller="UserNote" asp-action="Create" class="btn btn-primary btn-sm">+ New Note</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card-grid">
            @foreach (var note in Model)
            {
                <div class="card">
                    <div class="card-body">
                        <h3><a asp-controller="UserNote" asp-action="Details" asp-route-id="@note.NoteId">@note.Title</a></h3>
                        <p class="text-muted">@note.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>You haven't written any notes yet.</p>
    }
</section>
