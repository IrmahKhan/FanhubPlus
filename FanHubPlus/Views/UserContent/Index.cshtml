@model List<Content>
@{
    ViewData["Title"] = "Browse Content | FanHub+";
}

<main class="explore-page py-4">
    <div class="container-fluid site-container">
        <!-- HERO HEADER -->
        <div class="explore-hero mb-4 p-4 rounded-4 position-relative overflow-hidden shadow-lg border border-secondary border-opacity-20" style="background: linear-gradient(135deg, rgba(139,92,246,0.15) 0%, rgba(255,77,141,0.1) 100%); backdrop-filter: blur(16px);">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="section-label text-uppercase text-warning fw-bold tracking-wider" style="font-size: 0.8rem;">DISCOVER MEDIA & LORE</span>
                    <h1 class="display-6 fw-extrabold mb-2">Fandom <span>Content Library</span></h1>
                    <p class="text-muted mb-0">Explore videos, podcasts, digital art, and lore documents from across all fandoms.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Popular" class="btn btn-outline-primary rounded-pill px-3 py-2"><i class="bi bi-fire me-1"></i> Popular</a>
                    <a asp-action="Filter" class="btn btn-outline-secondary rounded-pill px-3 py-2"><i class="bi bi-funnel me-1"></i> Filter</a>
                </div>
            </div>

            <!-- SEARCH BAR -->
            <form asp-action="Search" method="get" class="mt-4">
                <div class="input-group shadow-sm rounded-pill overflow-hidden border border-primary border-opacity-25" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px);">
                    <span class="input-group-text bg-transparent border-0 ps-3 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="query" class="form-control bg-transparent border-0 text-body py-2" placeholder="Search anime series, game guides, comics, videos..." autocomplete="off" />
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Search</button>
                </div>
            </form>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden dash-card-hero">
                            <div class="card-body d-flex flex-column justify-content-between p-4">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary bg-opacity-20 text-primary px-3 py-2 rounded-pill fw-semibold">@item.Type</span>
                                        @if (item.Category != null)
                                        {
                                            <span class="badge bg-secondary bg-opacity-20 text-muted px-2 py-1 rounded-pill small">@item.Category.Name</span>
                                        }
                                    </div>
                                    <h4 class="card-title h5 fw-bold mb-2">
                                        <a asp-action="Details" asp-route-id="@item.ContentId" class="text-decoration-none text-body hover-pink">@item.Title</a>
                                    </h4>
                                </div>
                                <div class="mt-3 pt-3 border-top border-secondary border-opacity-20 d-flex justify-content-between align-items-center">
                                    <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i> @item.ReleaseDate.ToString("dd MMM yyyy")</span>
                                    <a asp-action="Details" asp-route-id="@item.ContentId" class="btn btn-sm btn-outline-primary rounded-pill px-3">View <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 rounded-4 shadow-sm border border-secondary border-opacity-20 dash-card-panel">
                <i class="bi bi-collection-play text-muted display-4 d-block mb-3"></i>
                <h4 class="fw-bold">No Content Available Yet</h4>
                <p class="text-muted">Check back soon for new videos, articles, and fandom releases.</p>
            </div>
        }
    </div>
</main>
