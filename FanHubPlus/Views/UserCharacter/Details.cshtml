@model CharacterProfile
@{
    ViewData["Title"] = Model.Name + " | FanHub+";
    var isBookmarked = ViewBag.IsBookmarked as bool? ?? false;
}

<main class="explore-page py-4">
    <div class="container-fluid site-container">
        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb fanhub-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Characters</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="mb-3">
            <a asp-action="Index" class="btn btn-sm rounded-pill px-3 py-2 btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Characters
            </a>
        </div>

        <div class="row g-4">
            <!-- MAIN CONTENT -->
            <div class="col-lg-8">
                <div class="p-4 rounded-4 shadow-sm border border-secondary border-opacity-20 dash-card-panel mb-4">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="rounded-4 overflow-hidden border border-secondary border-opacity-20 d-flex align-items-center justify-content-center" style="min-height: 260px; background: rgba(139, 92, 246, 0.08);">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-height: 320px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle" style="font-size: 4rem; opacity: .4;"></i>
                                }
                            </div>
                        </div>
                        <div class="col-md-8">
                            @if (Model.Category != null)
                            {
                                <a asp-controller="UserCategory" asp-action="Details" asp-route-id="@Model.Category.CategoryId"
                                   class="badge bg-primary bg-opacity-20 text-primary px-3 py-2 rounded-pill fw-semibold text-decoration-none mb-2 d-inline-block">
                                    <i class="bi bi-collection me-1"></i> @Model.Category.Name
                                </a>
                            }

                            <h1 class="fw-bold mb-3">@Model.Name</h1>

                            @if (!string.IsNullOrWhiteSpace(Model.Bio))
                            {
                                <p class="text-body opacity-75 mb-0" style="white-space: pre-line;">@Model.Bio</p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">No bio has been added for this character yet.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIDEBAR ACTIONS -->
            <div class="col-lg-4">
                <div class="p-4 rounded-4 shadow-sm border border-secondary border-opacity-20 dash-card-panel">
                    <h6 class="fw-bold mb-3 text-uppercase small tracking-wider text-muted">Actions</h6>
                    <div class="d-flex flex-column gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="UserBookmark" asp-action="Add" method="post">
                                <input type="hidden" name="itemType" value="Character" />
                                <input type="hidden" name="itemId" value="@Model.CharacterId" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                @if (isBookmarked)
                                {
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill" disabled>
                                        <i class="bi bi-bookmark-fill me-1"></i> Bookmarked
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-primary w-100 rounded-pill">
                                        <i class="bi bi-bookmark me-1"></i> Bookmark
                                    </button>
                                }
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary w-100 rounded-pill">
                                <i class="bi bi-bookmark me-1"></i> Login to Bookmark
                            </a>
                        }

                        <a asp-controller="UserShare" asp-action="Share"
                           asp-route-title="@Model.Name"
                           asp-route-url="@Url.Action("Details", "UserCharacter", new { id = Model.CharacterId })"
                           class="btn btn-outline-secondary w-100 rounded-pill">
                            <i class="bi bi-share me-1"></i> Share
                        </a>
                    </div>

                    @if (Model.Category != null)
                    {
                        <div class="mt-4 pt-3 border-top border-secondary border-opacity-20 small text-muted d-flex flex-column gap-2">
                            <span><i class="bi bi-collection me-1"></i> Category: @Model.Category.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>
