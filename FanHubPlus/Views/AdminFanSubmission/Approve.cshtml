@model FanSubmission

@{
    ViewData["Title"] = "Approve Submission";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="alert alert-success col-md-6">
        <h3>Approve Submission?</h3>
        <p>Are you sure you want to approve <strong>@Model.Title</strong>?</p>

        <form asp-action="Approve" asp-route-id="@Model.SubmissionId" method="post">
            <input type="hidden" asp-for="SubmissionId" />
            <button type="submit" class="btn btn-success">Yes, Approve</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>