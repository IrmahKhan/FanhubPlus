@model PagedList<CharacterProfile>

@{
    ViewData["Title"] = "Manage Characters";
    Layout = "_AdminLayout";
    var q = Context.Request.Query["q"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Character Profiles Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add New Character
        </a>
    </div>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-4">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search name or bio" aria-label="Search characters" />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" aria-label="Filter by category" asp-items="ViewBag.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sort" class="form-select" aria-label="Sort order">
                <option value="" selected="@(sort == "")">Name A-Z</option>
                <option value="newest" selected="@(sort == "newest")">Recently added</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Go</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Bio</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Category?.Name</td>
                        <td>@(item.Bio?.Length > 60 ? item.Bio.Substring(0, 57) + "..." : item.Bio)</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.CharacterId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.CharacterId" class="btn btn-sm btn-info text-white">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.CharacterId" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No characters match these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
