@model IEnumerable<MediaItem>

@{
    ViewData["Title"] = "Gallery";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-images me-2"></i>Image Gallery</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center">No gallery images found.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@item.FileUrl" class="card-img-top" alt="@item.Title" style="height: 220px; object-fit: cover;">
                        <div class="card-body p-2 text-center">
                            <h6 class="card-title text-truncate mb-1">@item.Title</h6>
                            <a asp-action="Details" asp-route-id="@item.MediaId" class="btn btn-sm btn-link text-decoration-none">View Full Size</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>