@model List<FeaturedArticle>
@{
    ViewData["Title"] = "Featured Articles & Stories | FanHub+";
}

<main class="explore-page py-4">
    <div class="container-fluid site-container">
        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb fanhub-breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Articles</a></li>
                <li class="breadcrumb-item active" aria-current="page">Featured</li>
            </ol>
        </nav>

        <!-- HEADER -->
        <div class="explore-heading reveal mb-5">
            <div>
                <span class="section-label">FEATURED STORIES & BREAKDOWNS</span>
                <h1 class="display-4 text-white fw-extrabold" style="font-family: 'Manrope', sans-serif;">Featured <span>Articles</span></h1>
                <p class="lead text-secondary">In-depth breakdowns, exclusive fandom lore, season analyses, and top stories.</p>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4 mb-5">
                @foreach (var article in Model)
                {
                    var imgUrl = !string.IsNullOrEmpty(article.ImageUrl) ? article.ImageUrl : "/images/explore/solo-leveling.png";

                    <div class="col-lg-4 col-md-6">
                        <article class="cyber-nebula-card reveal h-100 d-flex flex-column">
                            <div class="content-poster" style="height: 220px;">
                                <img src="@imgUrl" alt="@article.Title" class="w-100 h-100 object-fit-cover" />
                                <span class="trending-badge">#Featured</span>
                            </div>

                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <small class="text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> @article.PublishedAt.ToString("dd MMM yyyy")</small>
                                <h3 class="h5 text-white fw-bold mb-3">
                                    <a asp-action="Details" asp-route-id="@article.ArticleId" class="text-white text-decoration-none hover-pink">
                                        @article.Title
                                    </a>
                                </h3>
                                <div class="mt-auto pt-3 border-top border-secondary border-opacity-20 d-flex justify-content-between align-items-center">
                                    <span class="text-primary small fw-semibold">Exclusive Lore</span>
                                    <a asp-action="Details" asp-route-id="@article.ArticleId" class="cyber-read-btn">
                                        Read Article <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5 bg-dark bg-opacity-50 rounded-4">
                <i class="bi bi-newspaper display-1 d-block mb-3 opacity-50"></i>
                <p>No featured articles available at the moment.</p>
            </div>
        }

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> View All Articles
            </a>
        </div>
    </div>
</main>
