@model MerchandiseItem

@{
    ViewData["Title"] = "Delete Merchandise";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Delete Merchandise</h2>
    <h3 class="text-danger">Are you sure you want to delete this item?</h3>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>

            <dt class="col-sm-3">Tag</dt>
            <dd class="col-sm-9">@Model.Tag</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ItemId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>