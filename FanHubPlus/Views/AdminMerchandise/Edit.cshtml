@model MerchandiseItem

@{
    ViewData["Title"] = "Edit Merchandise Item";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Edit Merchandise Item</h2>
    <hr />
    <div class="row">
        <div class="col-lg-9">
            <form asp-action="Edit" asp-route-id="@Model.ItemId" method="post" enctype="multipart/form-data">
                <partial name="_Form" model="Model" />
                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}