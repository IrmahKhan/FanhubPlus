@model List<Bookmark>
@{
    ViewData["Title"] = "My Bookmarks";
}

<section class="bookmarks-page">
    <h1>My Bookmarks</h1>

    <div class="bookmark-tabs">
        <a asp-action="Index">All</a>
        <a asp-action="Content">Content</a>
        <a asp-action="Characters">Characters</a>
        <a asp-action="Media">Media</a>
        <a asp-action="Merchandise">Merchandise</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card-grid">
            @foreach (var bookmark in Model)
            {
                <div class="card">
                    <div class="card-body">
                        <span class="badge">@bookmark.ItemType</span>

                        @if (bookmark.ItemType == "Content" && bookmark.Content != null)
                        {
                            <h3>
                                <a asp-controller="UserContent" asp-action="Details" asp-route-id="@bookmark.Content.ContentId">
                                    @bookmark.Content.Title
                                </a>
                            </h3>
                        }
                        else if (bookmark.ItemType == "Character" && bookmark.Character != null)
                        {
                            <h3>
                                <a asp-controller="UserCharacter" asp-action="Details" asp-route-id="@bookmark.Character.CharacterId">
                                    @bookmark.Character.Name
                                </a>
                            </h3>
                        }
                        else if (bookmark.ItemType == "Media" && bookmark.MediaItem != null)
                        {
                            <h3>
                                <a asp-controller="UserMedia" asp-action="Details" asp-route-id="@bookmark.MediaItem.MediaId">
                                    @bookmark.MediaItem.Title
                                </a>
                            </h3>
                        }
                        else if (bookmark.ItemType == "Merchandise" && bookmark.MerchandiseItem != null)
                        {
                            <h3>
                                <a asp-controller="UserMerchandise" asp-action="Details" asp-route-id="@bookmark.MerchandiseItem.ItemId">
                                    @bookmark.MerchandiseItem.Name
                                </a>
                            </h3>
                        }

                        @if (!string.IsNullOrEmpty(bookmark.NoteText))
                        {
                            <p class="text-muted">@bookmark.NoteText</p>
                        }
                        <span class="text-muted">Saved @bookmark.CreatedAt.ToString("dd MMM yyyy")</span>

                        <form asp-action="Remove" asp-route-id="@bookmark.BookmarkId" method="post" class="inline-form">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>You haven't bookmarked anything yet. Start exploring and save what you like!</p>
    }
</section>
