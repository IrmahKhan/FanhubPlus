@model List<FanSubmission>
@{
    ViewData["Title"] = "My Submissions";
    Layout = "_DashboardLayout";
}

<section class="submissions-page">
    <div class="page-header">
        <h1>My Submissions</h1>
        <a asp-action="Create" class="btn btn-primary">+ New Submission</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card-grid">
            @foreach (var submission in Model)
            {
                <div class="card">
                    <div class="card-body">
                        <span class="badge">@submission.Status</span>
                        <h3><a asp-action="Details" asp-route-id="@submission.SubmissionId">@submission.Title</a></h3>
                        <p class="text-muted">@submission.SubmittedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>You haven't submitted anything yet.</p>
    }
</section>
