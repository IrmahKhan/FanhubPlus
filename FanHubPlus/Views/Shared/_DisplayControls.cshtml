<div class="d-flex align-items-center gap-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="Text size">
        <button type="button" class="btn btn-outline-secondary" data-ui="font-smaller" aria-label="Decrease text size" title="Smaller text">A-</button>
        <button type="button" class="btn btn-outline-secondary" data-ui="font-reset" aria-label="Reset text size" title="Default text size">A</button>
        <button type="button" class="btn btn-outline-secondary" data-ui="font-larger" aria-label="Increase text size" title="Larger text">A+</button>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-ui="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <i class="bi bi-moon-stars" data-ui="theme-icon"></i>
    </button>
</div>
