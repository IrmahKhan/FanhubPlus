@model PagedList<EventCategory>

@{
    ViewData["Title"] = "Event Categories Mapping";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Event Categories</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to Events List</a>
    </div>

    <p class="text-muted">Categories are assigned on the event's Create/Edit form. Use this page to review the mapping or remove a category from an event.</p>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <select name="categoryId" class="form-select" aria-label="Filter by category" asp-items="ViewBag.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Categories" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event Title</th>
                    <th>Category Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@item.EventId"><strong>@item.Event?.Title</strong></a></td>
                        <td><span class="badge bg-secondary">@item.Category?.Name</span></td>
                        <td class="text-end">
                            <form asp-action="RemoveCategory" method="post" class="d-inline"
                                  onsubmit="return confirm('Remove this category from the event?');">
                                <input type="hidden" name="eventId" value="@item.EventId" />
                                <input type="hidden" name="categoryId" value="@item.CategoryId" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">No event categories found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
