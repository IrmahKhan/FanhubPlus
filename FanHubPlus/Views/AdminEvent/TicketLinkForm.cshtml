@model EventTicketLink

@{
    var isEdit = Model.TicketLinkId > 0;
    ViewData["Title"] = isEdit ? "Edit Ticket Link" : "Add Ticket Link";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Event: <strong>@ViewBag.EventTitle</strong></p>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="@(isEdit ? "EditTicketLink" : "AddTicketLink")" asp-route-id="@(isEdit ? Model.TicketLinkId : (int?)null)" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="EventId" />
                @if (isEdit)
                {
                    <input type="hidden" asp-for="TicketLinkId" />
                }

                <div class="mb-3">
                    <label asp-for="PlatformName" class="form-label">Platform</label>
                    <input asp-for="PlatformName" class="form-control" placeholder="e.g. Eventbrite" />
                    <span asp-validation-for="PlatformName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Url" class="form-label">Ticket Link</label>
                    <input asp-for="Url" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="Url" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">@(isEdit ? "Save Changes" : "Add Link")</button>
                <a asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-secondary">Back to Event</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
