@model FeaturedArticle

@{
    ViewData["Title"] = "Delete Article";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Delete Featured Article</h2>
    <h3 class="text-danger">Are you sure you want to delete this article?</h3>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9"><strong>@Model.Title</strong></dd>

            <dt class="col-sm-3">Published At</dt>
            <dd class="col-sm-9">@Model.PublishedAt.ToString("yyyy-MM-dd")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ArticleId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>