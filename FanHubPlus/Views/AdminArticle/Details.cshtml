@model FeaturedArticle

@{
    ViewData["Title"] = "Article Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4 py-3 text-white">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-white"><i class="bi bi-newspaper me-2" style="color: #c084fc;"></i>Article Details</h3>
            <p class="text-muted small mb-0">View full details and content of the featured article.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ArticleId" class="btn btn-sm rounded-pill px-4 fw-semibold text-white shadow-sm d-flex align-items-center gap-1" style="background-color: #7b2cbf; border: none;">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-sm rounded-pill px-4 fw-semibold text-white shadow-sm d-flex align-items-center gap-1" style="background-color: #1a162b; border: 1px solid #3b3254;">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Details Card Container -->
    <div class="card shadow-lg border-0 rounded-4 p-4" style="background: linear-gradient(135deg, #12101e 0%, #1e1b38 100%); border: 1px solid #3b3254 !important;">
        <div class="row g-4 align-items-center mb-4 pb-4 border-bottom border-secondary border-opacity-25">
            <!-- Cover Image Column (Controlled Size) -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="col-md-4 text-center">
                    <div class="p-3 rounded-4 shadow-inner d-flex align-items-center justify-content-center" style="background-color: #1a162b; border: 1px solid #3b3254; min-height: 220px;">
                        <img src="@Model.ImageUrl" alt="Cover image" class="img-fluid rounded-3 shadow" style="max-height: 200px; width: 100%; object-fit: contain;" />
                    </div>
                </div>
            }

            <!-- Title & Metadata Column -->
            <div class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "col-12" : "col-md-8")">
                <span class="badge px-3 py-2 rounded-pill fw-semibold mb-3" style="background-color: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid #7c3aed; font-size: 0.8rem;">
                    <i class="bi bi-calendar3 me-1"></i> Published On: @Model.PublishedAt.ToString("yyyy-MM-dd HH:mm")
                </span>
                <h2 class="fw-bold text-white mb-0" style="line-height: 1.4;">@Model.Title</h2>
            </div>
        </div>

        <!-- Content Section -->
        <div>
            <h6 class="text-uppercase fw-bold mb-3" style="font-size: 0.85rem; letter-spacing: 1px; color: #c084fc;">Content</h6>
            <div class="article-body rounded-4 p-4 text-white shadow-sm" style="background-color: #1a162b; border: 1px solid #3b3254; line-height: 1.7;">
                @Html.Raw(RichText.Sanitize(Model.Content))
            </div>
        </div>
    </div>
</div>

<style>
    .article-body img {
        max-width: 100%;
        height: auto;
        max-height: 350px;
        object-fit: contain;
        border-radius: 8px;
        margin-top: 15px;
        margin-bottom: 15px;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
</style>