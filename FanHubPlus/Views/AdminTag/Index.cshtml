@model PagedList<Tag>

@{
    ViewData["Title"] = "Manage Tags";
    Layout = "_AdminLayout";
    var q = Context.Request.Query["q"].ToString();
    var contentCounts = ViewBag.ContentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var mediaCounts = ViewBag.MediaCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="page-head">
    <div>
        <h1 class="page-head-title"><i class="fa-solid fa-tags"></i> Tags</h1>
        <p class="page-head-subtitle">Labels attached to content and media items for filtering and discovery.</p>
    </div>
    <div class="page-head-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Tag</a>
    </div>
</div>

<div class="content-card">
    <form method="get" role="search" class="table-toolbar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="q" value="@q" class="form-control form-control-sm" placeholder="Search tags…" aria-label="Search tags" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        }
    </form>

    <div class="content-card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-tags"></i>
                <p>@(string.IsNullOrEmpty(q) ? "No tags yet — add your first one." : $"No tags match \"{q}\".")</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tag</th>
                            <th>Content items</th>
                            <th>Media items</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in Model)
                        {
                            <tr>
                                <td data-label="Tag"><strong>@tag.Name</strong></td>
                                <td data-label="Content items"><span class="count-pill">@(contentCounts.TryGetValue(tag.TagId, out var c) ? c : 0)</span></td>
                                <td data-label="Media items"><span class="count-pill">@(mediaCounts.TryGetValue(tag.TagId, out var m) ? m : 0)</span></td>
                                <td data-label="Actions">
                                    <div class="row-actions">
                                        <a asp-action="Edit" asp-route-id="@tag.TagId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="Delete" asp-route-id="@tag.TagId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="content-card-body pt-0">
        <partial name="_Pager" model="(IPagedList)Model" />
    </div>
</div>
