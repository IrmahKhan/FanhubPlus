@model Tag

@{
    ViewData["Title"] = "Add Tag";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <div>
        <h1 class="page-head-title"><i class="fa-solid fa-plus"></i> Add Tag</h1>
    </div>
</div>

<div class="content-card form-card">
    <div class="content-card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name <span class="required-mark">*</span></label>
                <input asp-for="Name" class="form-control" maxlength="50" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Create Tag</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
