@model Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-4"><i class="bi bi-arrow-left me-1"></i>Back to Calendar</a>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 p-4">
                <span class="badge bg-primary w-auto mb-2" style="width: fit-content;">
                    <i class="bi bi-calendar-event me-1"></i>Calendar Event
                </span>
                <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>

                <div class="d-flex align-items-center text-muted mb-3 flex-wrap gap-3">
                    <div><i class="bi bi-calendar3 text-primary me-2"></i>@Model.EventDate.ToString("dddd, MMMM dd, yyyy")</div>
                    <div><i class="bi bi-clock text-primary me-2"></i>@Model.EventDate.ToString("hh:mm tt")</div>
                    <div><i class="bi bi-geo-alt text-primary me-2"></i>@(string.IsNullOrEmpty(Model.City) ? "Online / TBD" : Model.City)</div>
                </div>

                <hr />

                <h5 class="fw-bold mb-2">Description</h5>
                <p class="text-secondary" style="white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Description) ? "No detailed description available." : Model.Description)
                </p>

                @if (Model.EventCategories != null && Model.EventCategories.Any())
                {
                    <div class="mt-3">
                        <h6 class="fw-bold">Categories:</h6>
                        @foreach (var ec in Model.EventCategories)
                        {
                            <span class="badge bg-secondary me-1">#@ec.Category?.Name</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-map me-2"></i>Venue Information
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>City:</strong> @(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)</p>
                    @if (!string.IsNullOrEmpty(Model.LocationCoordinates))
                    {
                        <p class="mb-1"><strong>Location:</strong> @Model.LocationCoordinates</p>
                        <div class="ratio ratio-4x3 rounded overflow-hidden border mt-2">
                            <iframe src="https://maps.google.com/maps?q=@Uri.EscapeDataString(Model.LocationCoordinates)&output=embed"
                                    style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="bi bi-ticket-perforated me-2"></i>Ticket Booking Links
                </div>
                <div class="card-body">
                    @if (Model.EventTicketLinks != null && Model.EventTicketLinks.Any())
                    {
                        <div class="d-grid gap-2">
                            @foreach (var link in Model.EventTicketLinks)
                            {
                                <button type="button" class="btn btn-outline-primary text-start"
                                        data-bs-toggle="modal" data-bs-target="#ticketModal"
                                        data-platform="@link.PlatformName" data-url="@link.Url">
                                    <i class="bi bi-info-circle me-2"></i>@link.PlatformName
                                </button>
                            }
                        </div>

                        <!-- Ticket Info Modal: shows the link as text only, no auto-redirect away from the site -->
                        <div class="modal fade" id="ticketModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h6 class="modal-title" id="ticketModalPlatform">Ticket Info</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="small text-muted mb-2">Tickets for this event are sold by the platform below. Copy the link to purchase on their website:</p>
                                        <div class="input-group">
                                            <input type="text" id="ticketModalUrl" class="form-control form-control-sm" readonly>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="navigator.clipboard.writeText(document.getElementById('ticketModalUrl').value)">
                                                <i class="bi bi-clipboard"></i> Copy
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <script>
                            document.getElementById('ticketModal')?.addEventListener('show.bs.modal', function (event) {
                                var btn = event.relatedTarget;
                                document.getElementById('ticketModalPlatform').textContent = btn.getAttribute('data-platform') + ' — Ticket Link';
                                document.getElementById('ticketModalUrl').value = btn.getAttribute('data-url');
                            });
                        </script>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No ticket links are associated with this calendar event.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
