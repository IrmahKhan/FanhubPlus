@model IEnumerable<Event>

@{
    ViewData["Title"] = "Monthly Calendar";
    int currentMonth = ViewBag.SelectedMonth ?? DateTime.Now.Month;
    int currentYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    var monthName = new DateTime(currentYear, currentMonth, 1).ToString("MMMM yyyy");
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-calendar-month me-2 text-primary"></i>Monthly View</h2>
            <p class="text-muted mb-0">Events for <strong>@monthName</strong></p>
        </div>
        <div class="btn-group" role="group">
            <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-list-task me-1"></i>All Events</a>
            <a asp-action="Monthly" class="btn btn-primary active"><i class="bi bi-calendar-month me-1"></i>Monthly View</a>
        </div>
    </div>

    <!-- Month Navigator -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-light">
        <form method="get" asp-action="Monthly" class="row g-2 align-items-center">
            <div class="col-6 col-md-4">
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mName = new DateTime(2026, m, 1).ToString("MMMM");
                        <option value="@m" selected="@(m == currentMonth)">@mName</option>
                    }
                </select>
            </div>
            <div class="col-4 col-md-3">
                <select name="year" class="form-select">
                    @for (int y = 2025; y <= 2030; y++)
                    {
                        <option value="@y" selected="@(y == currentYear)">@y</option>
                    }
                </select>
            </div>
            <div class="col-2 col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Go</button>
            </div>
        </form>
    </div>

    <!-- Monthly Events List -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center p-5 rounded-3">
            <i class="bi bi-calendar-event display-4 d-block mb-3 text-muted"></i>
            <h4>No Events Scheduled for @monthName</h4>
            <p class="mb-0">Select a different month or year to check upcoming schedules.</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm border-0">
            @foreach (var evt in Model)
            {
                <div class="list-group-item list-group-item-action p-3 mb-2 border rounded-3">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center border-end-md">
                            <h3 class="fw-bold text-primary mb-0">@evt.EventDate.ToString("dd")</h3>
                            <small class="text-uppercase fw-bold text-muted">@evt.EventDate.ToString("ddd")</small>
                        </div>
                        <div class="col-md-7">
                            <h5 class="fw-bold mb-1">@evt.Title</h5>
                            <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(evt.City) ? "Online" : evt.City) | <i class="bi bi-clock me-1"></i>@evt.EventDate.ToString("hh:mm tt")</p>
                        </div>
                        <div class="col-md-3 text-md-end mt-2 mt-md-0">
                            <a asp-action="EventDetails" asp-route-id="@evt.EventId" class="btn btn-outline-primary btn-sm">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>