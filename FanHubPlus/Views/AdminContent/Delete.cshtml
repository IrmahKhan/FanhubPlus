@model Content

@{
    ViewData["Title"] = "Delete Content";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h2>Delete Content</h2>
    <h5 class="text-danger">Are you sure you want to delete this?</h5>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9"><strong>@Model.Title</strong></dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Type</span></dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Release Date</dt>
        <dd class="col-sm-9">@Model.ReleaseDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Popularity Score</dt>
        <dd class="col-sm-9">@Model.PopularityScore</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.ContentId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
