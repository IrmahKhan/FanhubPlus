@model PagedList<Content>

@{
    ViewData["Title"] = "Manage Content";
    Layout = "_AdminLayout";
    var q = Context.Request.Query["q"].ToString();
    var type = Context.Request.Query["type"].ToString();
    var sort = Context.Request.Query["sort"].ToString();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Fandom Content Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add New Content
        </a>
    </div>

    <form method="get" class="row g-2 mb-3" role="search">
        <div class="col-md-3">
            <input type="search" name="q" value="@q" class="form-control" placeholder="Search title or description" aria-label="Search content" />
        </div>
        <div class="col-md-2">
            <select name="categoryId" class="form-select" aria-label="Filter by category" asp-items="ViewBag.Categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="type" class="form-select" aria-label="Filter by type">
                <option value="">All types</option>
                @foreach (var t in AdminOptions.ContentTypes)
                {
                    <option value="@t" selected="@(type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="tagId" class="form-select" aria-label="Filter by tag" asp-items="ViewBag.Tags">
                <option value="">All tags</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sort" class="form-select" aria-label="Sort order">
                <option value="" selected="@(sort == "")">Newest release</option>
                <option value="oldest" selected="@(sort == "oldest")">Oldest release</option>
                <option value="popular" selected="@(sort == "popular")">Most popular</option>
                <option value="title" selected="@(sort == "title")">Title A-Z</option>
            </select>
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Go</button>
        </div>
        <div class="col-12">
            <a asp-action="Index" class="btn btn-link btn-sm px-0">Reset filters</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Release Date</th>
                    <th>Popularity</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Category?.Name</td>
                        <td><span class="badge bg-secondary">@item.Type</span></td>
                        <td>@item.ReleaseDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.PopularityScore</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.ContentId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.ContentId" class="btn btn-sm btn-info text-white">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.ContentId" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No content matches these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPagedList)Model" />
</div>
