@model Content

@{
    var allTags = ViewBag.AllTags as List<Tag> ?? new List<Tag>();
    var selectedTags = ViewBag.SelectedTags as HashSet<int> ?? new HashSet<int>();
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.ContentId > 0)
{
    <input type="hidden" asp-for="ContentId" />
}

<div class="field-grid">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select">
            @foreach (var t in AdminOptions.WithCurrent(AdminOptions.ContentTypes, Model.Type))
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReleaseDate" class="form-label">Release Date</label>
        <input asp-for="ReleaseDate" type="date" class="form-control" />
        <span asp-validation-for="ReleaseDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PopularityScore" class="form-label">Popularity Score</label>
        <input asp-for="PopularityScore" class="form-control" />
        <div class="form-text">Normally calculated from views and bookmarks (Analytics > Content Views); edit here only to override.</div>
        <span asp-validation-for="PopularityScore" class="text-danger"></span>
    </div>

    <div class="mb-3 field-full">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label fs-6">Tags</legend>
        @if (allTags.Count == 0)
        {
            <p class="text-muted small mb-0">No tags yet. <a asp-controller="AdminTag" asp-action="Create">Create one</a>.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-3">
                @foreach (var tag in allTags)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="selectedTags" value="@tag.TagId" id="tag-@tag.TagId" checked="@selectedTags.Contains(tag.TagId)" />
                        <label class="form-check-label" for="tag-@tag.TagId">@tag.Name</label>
                    </div>
                }
            </div>
        }
    </fieldset>
</div>
