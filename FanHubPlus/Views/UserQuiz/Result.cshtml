@model QuizAttempt

@{
    ViewData["Title"] = "Quiz Result";
}

<div class="container py-4 text-center">
    <h2>@Model.Quiz.Title - Result</h2>

    <div class="card mx-auto mt-4" style="max-width: 400px;">
        <div class="card-body">
            <h1 class="display-4">@Model.PercentageScore%</h1>
            <p class="text-muted mb-0">You scored @Model.Score out of @Model.TotalQuestions</p>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Leaderboard" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary">View Leaderboard</a>
        <a asp-action="Index" class="btn btn-primary">Back to Quizzes</a>
    </div>
</div>
