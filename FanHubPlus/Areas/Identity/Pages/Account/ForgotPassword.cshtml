@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password? | FanHub+";
}

<div class="d-flex align-items-center justify-content-center py-4 my-auto" style="min-height: calc(100vh - 140px); position: relative; z-index: 2;">
    <div class="card cosmic-auth-card shadow-lg border-0" style="max-width: 440px; width: 100%;">
        
        <!-- Header Star Icon -->
        <div class="text-center mb-4 pt-1">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #FF4D8D, #8B5CF6); box-shadow: 0 8px 25px rgba(255, 77, 141, 0.35);">
                <i class="bi bi-key-fill text-white fs-2"></i>
            </div>
            <h3 class="fw-extrabold mb-1" style="font-family: 'Manrope', sans-serif; font-size: 1.65rem;">Forgot Password? ✨</h3>
            <p class="auth-muted small mb-0">No worries — we'll send reset instructions to your email</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center" role="alert"></div>

            <!-- Email Field -->
            <div class="mb-4 text-start">
                <label asp-for="Input.Email" class="form-label small fw-bold mb-1"><i class="bi bi-envelope me-1 text-primary"></i> Email Address</label>
                <input asp-for="Input.Email" class="form-control py-2.5 px-3" autocomplete="username" aria-required="true" placeholder="Enter your email address" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-100 py-2.5 btn text-white fw-bold text-uppercase tracking-wider" style="background: linear-gradient(135deg, #FF4D8D, #8B5CF6); border-radius: 14px; border: none; box-shadow: 0 6px 20px rgba(255, 77, 141, 0.35); font-size: 0.9rem; font-weight: 800;">
                Send Reset Link <i class="bi bi-send-fill ms-1"></i>
            </button>
        </form>

        <!-- Footer Back to Login Link -->
        <div class="text-center mt-3 pt-3 border-top border-secondary border-opacity-25">
            <a asp-page="./Login" class="fw-bold text-decoration-none small" style="color: #FF4D8D;">&larr; Back to Login</a>
            <p class="auth-muted small mt-2 mb-0" style="font-size: 0.8rem;">Link expires in 10 minutes</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
