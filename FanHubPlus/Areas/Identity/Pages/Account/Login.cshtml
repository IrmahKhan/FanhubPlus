@page
@model LoginModel

@{
    ViewData["Title"] = "Log in | FanHub+";
}

<div class="d-flex align-items-center justify-content-center py-4 my-auto" style="min-height: calc(100vh - 140px); position: relative; z-index: 2;">
    <div class="card cosmic-auth-card shadow-lg border-0" style="max-width: 440px; width: 100%;">
        
        <!-- Header Avatar / Icon -->
        <div class="text-center mb-4 pt-1">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: linear-gradient(135deg, #FF4D8D, #8B5CF6); box-shadow: 0 8px 25px rgba(255, 77, 141, 0.35);">
                <i class="bi bi-headphones text-white fs-2"></i>
            </div>
            <h3 class="fw-extrabold mb-1" style="font-family: 'Manrope', sans-serif; font-size: 1.65rem;">Welcome Back! </h3>
            <p class="auth-muted small mb-0">Log in to access your fandom codex, bookmarks & community</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center" role="alert"></div>

            <!-- Email Field -->
            <div class="mb-3 text-start">
                <label asp-for="Input.Email" class="form-label small fw-bold mb-1"><i class="bi bi-envelope me-1 text-primary"></i> Email Address</label>
                <input asp-for="Input.Email" class="form-control py-2.5 px-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Password Field -->
            <div class="mb-3 text-start">
                <label asp-for="Input.Password" class="form-label small fw-bold mb-1"><i class="bi bi-lock me-1 text-primary"></i> Password</label>
                <input asp-for="Input.Password" class="form-control py-2.5 px-3" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                    <label class="form-check-label auth-muted small" for="rememberMeCheck">
                        Remember Me
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none fw-bold" style="color: #FF4D8D;">Forgot Password?</a>
            </div>

            <!-- Submit Button -->
            <button id="login-submit" type="submit" class="w-100 py-2.5 btn text-white fw-bold text-uppercase tracking-wider" style="background: linear-gradient(135deg, #FF4D8D, #8B5CF6); border-radius: 14px; border: none; box-shadow: 0 6px 20px rgba(255, 77, 141, 0.35); font-size: 0.9rem; font-weight: 800;">
                Log In <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

        <!-- Footer Register Link -->
        <div class="text-center mt-3 pt-3 border-top border-secondary border-opacity-25">
            <p class="auth-muted small mb-0">
                Don't have an account? 
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none ms-1" style="color: #8B5CF6;">Join FanHub+ &rarr;</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}